# Copy this file to .env and fill in real values before running in production.

PORT=3000

# Long random string used to sign admin session JWTs. Generate your own,
# e.g.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-this-to-a-long-random-secret

# "production" disables verbose error output and enables secure cookies
NODE_ENV=development

# Production domain (no trailing slash) — used to build the live sitemap.xml
# and should match seo-config.js's SITE_URL. Set this in Vercel's Project
# Settings → Environment Variables for the Production environment.
SITE_URL=https://wateemperfumeseg.com

# PostgreSQL connection string (e.g. from Neon via Vercel Storage)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Cloudinary — used for all product/brand/category image uploads.
# Get these from your Cloudinary dashboard after creating a free account.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Green API — sends new-order details to the store owner's WhatsApp.
# Create a free instance at green-api.com, link it to your WhatsApp number
# by scanning the QR code, then copy idInstance/apiTokenInstance below.
GREENAPI_PHONE=201027380269
GREENAPI_ID_INSTANCE=
GREENAPI_API_TOKEN=

# Meta (Facebook/Instagram) Pixel + Conversions API. The pixel id is public;
# the access token is SECRET — set it only here / in Vercel env vars, never in
# frontend code. Generate it in Events Manager → dataset → Settings →
# Conversions API → Generate access token.
META_PIXEL_ID=2142124783046397
META_CAPI_TOKEN=
# optional: paste the code from Events Manager → Test events to see server
# events arrive live while testing; remove it afterwards
META_TEST_EVENT_CODE=
